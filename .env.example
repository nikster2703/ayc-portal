# Copy this file to .env and fill in your values.
# .env is never committed to version control.

# A long random string — Flask uses this to sign session cookies.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_string

# ── Postcode lookup (Ideal Postcodes) ──────────────────────────────────────────
# getaddress.io shut down on 4 Feb 2026. The replacement is Ideal Postcodes,
# which offers a drop-in compatible endpoint. Sign up at https://ideal-postcodes.co.uk
# and paste your API key here. Leave blank to disable the Find button on reg forms.
GETADDRESS_KEY=your_api_key_here

# Set to 'production' when live. Leave as 'development' on the Mac Mini.
FLASK_ENV=development

# ── Gmail SMTP (for mailshots) ─────────────────────────────────────────────
# 1. In your Google Account → Security → 2-Step Verification must be ON.
# 2. Go to Google Account → Security → App passwords.
# 3. Choose "Mail" + "Other (custom name)" → name it "AYC Portal" → Generate.
# 4. Paste the 16-character App Password below (spaces don't matter).
#
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=yourclub@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM=Ashford Youth Club <yourclub@gmail.com>
