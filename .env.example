# Copy this file to .env and fill in your values.
# .env is never committed to version control.

# ── Port ──────────────────────────────────────────────────────────────────────
# The port the portal will be accessible on from your browser.
# e.g. http://<server-ip>:5001
# Change this before running docker compose build for the first time.
PORT=5001

# ── Club identity ─────────────────────────────────────────────────────────────
# CLUB_NAME      : Full club name shown in headers, registration forms, emails
# CLUB_SHORT_NAME: Short abbreviation used for member ID prefix (e.g. AYC001)
CLUB_NAME=Your Club Name
CLUB_SHORT_NAME=YCN

# ── Flask ─────────────────────────────────────────────────────────────────────
# Flask session signing key — generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_string

# Set to 'production' when live.
FLASK_ENV=production

# ── Database encryption (SQLCipher) ───────────────────────────────────────────
# Keep this key extremely secure — losing it makes the database permanently unreadable.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DB_ENCRYPTION_KEY=replace_with_a_long_random_string

# ── Document encryption (Fernet) ──────────────────────────────────────────────
# Dedicated key for encrypting uploaded documents, kept separate from the DB key.
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this secure. Do NOT change it once documents have been uploaded, or those
# files will become unreadable. If left blank, the portal falls back to deriving
# a key from DB_ENCRYPTION_KEY (less ideal — set a dedicated key on fresh installs).
DOCUMENT_ENCRYPTION_KEY=replace_with_a_fernet_key

# ── Postcode lookup (Ideal Postcodes) ─────────────────────────────────────────
# Sign up at https://ideal-postcodes.co.uk and paste your API key here.
# Leave blank to disable the address finder on registration forms.
GETADDRESS_KEY=

# ── Gmail SMTP (for mailshots) ────────────────────────────────────────────────
# 1. Google Account → Security → 2-Step Verification must be ON
# 2. Google Account → Security → App passwords → create one named "Portal"
# 3. Paste the 16-character code below
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=yourclub@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM=Your Club Name <yourclub@gmail.com>
