# ── AYC Portal — LIVE instance environment ────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is never committed to version control.

# Flask session signing key — generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_string

# Database encryption key — generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# KEEP THIS SAFE — losing it makes the database permanently unreadable.
DB_ENCRYPTION_KEY=replace_with_a_long_random_string

# Club identity
CLUB_NAME=Ashford Youth Club
CLUB_SHORT_NAME=AYC

# Environment
FLASK_ENV=production
FLASK_DEBUG=0

# Postcode lookup (Ideal Postcodes) — leave blank to disable
GETADDRESS_KEY=

# Gmail SMTP (for mailshots)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=yourclub@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM=Ashford Youth Club <yourclub@gmail.com>
