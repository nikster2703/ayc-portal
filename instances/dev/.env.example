# ── AYC Portal — DEV instance environment ─────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is never committed to version control.

# Flask session signing key — can be any string for dev
SECRET_KEY=dev-secret-key-change-me

# Database encryption key — generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DB_ENCRYPTION_KEY=replace_with_a_long_random_string

# Club identity
CLUB_NAME=Ashford Youth Club (Dev)
CLUB_SHORT_NAME=AYC

# Environment
FLASK_ENV=development
FLASK_DEBUG=1

# Postcode lookup — leave blank to disable
GETADDRESS_KEY=

# Gmail SMTP — can point to a test account for dev
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=yourclub@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM=AYC Dev <yourclub@gmail.com>
